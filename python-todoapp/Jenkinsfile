pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'todo-app'
        DOCKER_TAG = "${BUILD_NUMBER}"
        ARTIFACTORY_URL = 'http://artifactory:8082'
        ARTIFACTORY_REPO = 'docker-local'
        SONAR_PROJECT_KEY = 'python-todo-app'
        KIND_CLUSTER_NAME = 'local-cluster'
    }

    tools {
        jdk 'JDK11'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh """
                        sonar-scanner \
                        -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                        -Dsonar.sources=. \
                        -Dsonar.python.version=3.9 \
                        -Dsonar.python.coverage.reportPaths=coverage.xml
                    """
                }
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}", "-f Dockerfile .")
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh """
                    trivy image --severity HIGH,CRITICAL \
                    --exit-code 1 \
                    ${DOCKER_IMAGE}:${DOCKER_TAG}
                """
            }
        }

        stage('Push to Artifactory') {
            steps {
                script {
                    docker.withRegistry("${ARTIFACTORY_URL}", 'artifactory-credentials') {
                        docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}")
                            .push()
                        docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}")
                            .push('latest')
                    }
                }
            }
        }

        stage('Deploy to KIND Cluster') {
            steps {
                script {
                    // Ensure KIND cluster exists
                    sh """
                        if ! kind get clusters | grep -q '^${KIND_CLUSTER_NAME}\$'; then
                            kind create cluster --name ${KIND_CLUSTER_NAME}
                        fi
                    """

                    // Load the image into KIND
                    sh "kind load docker-image ${DOCKER_IMAGE}:${DOCKER_TAG} --name ${KIND_CLUSTER_NAME}"

                    // Apply Kyverno policies
                    sh """
                        kubectl apply -f kyverno-policies/
                        sleep 10  # Wait for policies to be active
                    """

                    // Deploy the application
                    sh """
                        kubectl apply -f k8s/
                        kubectl set image deployment/todo-app todo-app=${DOCKER_IMAGE}:${DOCKER_TAG}
                    """
                }
            }
        }
    }

    post {
        always {
            // Clean up resources
            cleanWs()
            sh "docker rmi ${DOCKER_IMAGE}:${DOCKER_TAG} || true"
        }
    }
} 